{
  "agent": {
    "default_model": {
      "effort": "high",
      "provider": "opencode",
      "model": "go/deepseek-v4-flash",
      "enable_thinking": true
    },
    "dock": "left",
    "expand_terminal_card": false,
    "play_sound_when_agent_done": "when_hidden",
    "thinking_display": "always_collapsed",
    "tool_permissions": {
      "default": "allow"
    }
  },
  "agent_servers": {
    "pi-acp": {
      "default_config_options": {
        "model": "opencode-go/glm-5.3-flash",
        "thought_level": "medium"
      },
      "type": "registry"
    },
    "opencode": {
      "default_config_options": {
        "effort": "high",
        "model": "opencode-go/deepseek-v4-flash"
      },
      "type": "registry"
    }
  },
  "auto_install_extensions": {
    "charmed-icons": true,
    "dockerfile": true,
    "emmet": true,
    "env": true,
    "git-firefly": true,
    "html": true,
    "lua": true,
    "mcp-server-context7": true,
    "oxc": true,
    "rainbow-csv": true,
    "sql": true,
    "svelte": true,
    "toml": true,
    "vue": true,
    "zig": true
  },
  "auto_update": false,
  "buffer_font_family": "Sligoil",
  "buffer_font_features": {
    "ss01": true
  },
  "buffer_font_size": 14,
  "buffer_line_height": "comfortable",
  "cli_default_open_behavior": "new_window",
  "colorize_brackets": true,
  "edit_predictions": {
    "allow_data_collection": "no",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
    "mode": "eager",
    "provider": "zed"
  },
  "file_types": {
    "Shell Script": ["Brewfile"]
  },
  "format_on_save": "off",
  "git": {
    "inline_blame": {
      "enabled": true,
      "show_commit_summary": true,
      "min_column": 50,
      "delay_ms": 500
    }
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Base Charmed Icons",
    "dark": "Base Charmed Icons"
  },
  "indent_guides": {
    "active_line_width": 1,
    "coloring": "indent_aware",
    "line_width": 1
  },
  "languages": {
    "TypeScript": {
      "language_servers": ["vtsls"]
    }
  },
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    },
    "eslint": {
      "settings": {
        "onIgnoredFiles": "off"
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "files": {
          "exclude": ["**/components/ui/**"]
        },
        "experimental": {
          "classRegex": [
            ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*)"],
            ["[\\w-]*[Cc]lass\\s*=\\s*(?!['\"`]cn\\()((?:['\"`]|\\{)[^'\"`\\n<]*(?:'[^'\\n<]*'[^'\"`\\n<]*)*(?:['\"`]|\\}))", "['\"`]([^'\"`]*)"]
          ]
        }
      }
    },
    "vscode-css-language-server": {
      "settings": {
        "css": {
          "lint": {
            "unknownAtRules": "ignore"
          }
        }
      }
    },
    "vtsls": {
      "enable_lsp_tasks": true,
      "settings": {
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      }
    }
  },
  "minimap": {
    "show": "always"
  },
  "project_panel": {
    "dock": "right",
    "entry_spacing": "standard"
  },
  "search": {
    "case_sensitive": true
  },
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "cursor_shape": "underline",
    "line_height": {
      "custom": 1.25
    },
    "font_family": "Sligoil Micro NF",
    "font_features": {
      "ss01": true
    },
    "font_size": 12
  },
  "theme": {
    "mode": "dark",
    "light": "Pace Dark",
    "dark": "Twilight"
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true
  },
  "ui_font_family": "Sligoil",
  "ui_font_features": {
    "ss01": true
  },
  "ui_font_size": 14
}
